// firestore.rules
// Reglas de seguridad para Roomly Hub

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Solo usuarios autenticados pueden leer/escribir sus propios datos de agencia
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAgencyOwner(agencyId) {
      return request.auth.uid == agencyId;
    }

    // Properties: la agencia solo ve sus propias propiedades
    match /properties/{propertyId} {
      allow read, write: if isAuthenticated() && isAgencyOwner(resource.data.agencyId);
      allow create: if isAuthenticated() && isAgencyOwner(request.resource.data.agencyId);
    }

    // Rooms: accesibles si la agencia es propietaria del piso
    match /rooms/{roomId} {
      allow read, write: if isAuthenticated();
    }

    // Tenants: accesibles para agencias autenticadas
    match /tenants/{tenantId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Incidents: la agencia gestiona las de sus pisos
    match /incidents/{incidentId} {
      allow read, write: if isAuthenticated() && isAgencyOwner(resource.data.agencyId);
      allow create: if isAuthenticated();
    }

    // Payments: la agencia gestiona los de sus pisos
    match /payments/{paymentId} {
      allow read, write: if isAuthenticated() && isAgencyOwner(resource.data.agencyId);
      allow create: if isAuthenticated();
    }
  }
}
